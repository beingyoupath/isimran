rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == 'beingyoupath@gmail.com' || 
         request.auth.token.email == 'ISIMRAN662@gmail.com' ||
         request.auth.token.email == 'isimran662@gmail.com' ||
         request.auth.token.email.lower() == 'isimran662@gmail.com' ||
         request.auth.token.email.lower() == 'beingyoupath@gmail.com');
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidInquiry(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 150 &&
             (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 40)) &&
             data.question is string && data.question.size() > 0 && data.question.size() <= 2000 &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('status' in data) || (data.status in ['pending', 'reviewed', 'emailed'])) &&
             (!('frequency' in data) || (data.frequency in ['daily', 'weekly'])) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSignedIn() && (request.auth.uid == userId || isAdmin()));
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isValidId(userId) && isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Chatbot questions & inquiries collection
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow update: if isValidId(inquiryId) && isAdmin() && isValidInquiry(request.resource.data);
      allow delete: if isValidId(inquiryId) && isAdmin();
    }
  }
}
