{
  "entities": {
    "user": {
      "title": "User",
      "description": "User account profile authenticated via Firebase Auth",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Authentication UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User avatar photo URL" },
        "createdAt": { "type": "string", "description": "Timestamp when user was created" },
        "updatedAt": { "type": "string", "description": "Timestamp when user was last updated" }
      },
      "required": ["uid", "email"]
    },
    "inquiry": {
      "title": "Inquiry",
      "description": "User question, name, email, and whatsapp captured through chatbot concierge",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique inquiry ID" },
        "name": { "type": "string", "maxLength": 100, "description": "Full name of the user" },
        "email": { "type": "string", "format": "email", "maxLength": 150, "description": "Contact email address of the user" },
        "whatsapp": { "type": "string", "maxLength": 40, "description": "WhatsApp contact number of the user" },
        "question": { "type": "string", "maxLength": 2000, "description": "Question or inquiry text" },
        "userId": { "type": "string", "description": "Optional authenticated user UID" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "emailed"], "description": "Review and digest delivery status" },
        "frequency": { "type": "string", "enum": ["daily", "weekly"], "description": "Digest schedule preference" },
        "createdAt": { "type": "string", "description": "ISO or Server Timestamp of inquiry creation" }
      },
      "required": ["name", "email", "whatsapp", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Collection of user profile documents indexed by user UID"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Collection of chatbot user questions and contact details for daily/weekly email sharing"
    }
  }
}
